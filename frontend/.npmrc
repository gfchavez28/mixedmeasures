ignore-scripts=true

# #1096: install only package versions published at least 7 days ago. It acts where a NEW
# version can enter — `npm install <pkg>`, `npm update`, `npm audit fix` — and never on
# `npm ci`, which installs the lockfile as written (measured on npm 11.16.0, 2026-09-28: a
# 100000-day window still installed all 430 locked packages). A poisoned release is usually
# found and pulled within days (the 09-07 Shai-Hulud resurfacing passed npm's own scan), so
# the window keeps us out of that first stretch. The policy's "wait several days" for minor
# and major bumps, made mechanical.
#
# A named security fix younger than the window is taken deliberately, per command, and the
# commit says so:  npm update <pkg> --package-lock-only --min-release-age=0
# (dependency-security.md §5).
min-release-age=7
